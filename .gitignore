# ─── 의존성 ───────────────────────────────
# 날짜 폴더마다 생기므로 경로를 고정하지 않는다 (39/node_modules, 44/node_modules …)
node_modules/

# ─── 빌드 산출물 · 캐시 ────────────────────
dist/
.vite/
*.tsbuildinfo

# ─── 로그 ─────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ─── 환경 변수 (3겹 서버리스에서 필요해짐) ──
.env
.env.*
!.env.example

# ─── OS 부스러기 ──────────────────────────
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── 에디터 ───────────────────────────────
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── 로컬 전용 설정 ────────────────────────
.claude/settings.local.json
